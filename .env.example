# Copy to `.env` next to docker-compose.yml and fill in every required value.
# Compose refuses to start while a required value is empty.
# Generate each secret independently, for example: openssl rand -hex 32
# (hex output avoids `$`, which Compose would try to interpolate).

# Required: application JWT signing key shared by identity (issuer) and the
# orchestrator (verifier). At least 32 characters.
JWT_SECRET=

# Required: front-end session signing key. At least 32 characters.
SESSION_SECRET=

# Required: RabbitMQ account used by every service. The broker has no host
# ports; only containers on the Compose network reach it. Use letters and
# digits only (the values are embedded in amqp:// URLs): for example user
# `clearsky` and a password from `openssl rand -hex 32` (paste the output;
# .env does not run commands).
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Required: one password per database (letters and digits only; they are
# embedded in connection URLs). No database publishes a host port; see
# docker-compose.override.example.yml for temporary local access.
IDENTITY_DB_PASSWORD=
INSTITUTIONS_DB_PASSWORD=
GRADES_INGEST_DB_PASSWORD=
GRADES_QUERY_DB_PASSWORD=
REVIEWS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=

# Optional: must be identical for identity and the orchestrator (the root
# Compose file passes the same values to both).
# JWT_ISSUER=clearsky-identity
# JWT_AUDIENCE=clearsky-api

# Entry point. The proxy (Caddy) serves https://localhost with its own local
# CA (see README). A public domain gets a certificate automatically.
# SITE_ADDRESS=localhost
# HTTP_PORT=80
# HTTPS_PORT=443
# Public address used in emailed links and the Google redirect URL.
PUBLIC_APP_URL=https://localhost
# Session cookies require HTTPS. Set false only for a plain-HTTP setup
# (SITE_ADDRESS=http://…).
COOKIE_SECURE=true

# Google OAuth client (required for Google login). Its authorised redirect
# URI is PUBLIC_APP_URL + /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for Google login: university email domains, comma separated.
# Only verified Google accounts of these domains may sign in.
GOOGLE_ALLOWED_DOMAINS=
# true (default): the account must also belong to the university's Google
# Workspace. Set false only if the university does not use Google Workspace.
GOOGLE_REQUIRE_WORKSPACE=true

# Account emails (student confirmation, instructor invitations).
# Unset SMTP_HOST delivers to the local Mailpit inbox (http://127.0.0.1:8025).
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ClearSky <no-reply@example.edu>
# Upper limit of account emails per hour (anti-spam). Default 500.
# EMAIL_HOURLY_LIMIT=500

# Per-client limit for login, registration, activation and password reset.
# Generous defaults: campus networks put many students behind few addresses;
# per-account backoff is the main defence against password guessing.
# AUTH_RATE_LIMIT_PER_MINUTE=60
# AUTH_RATE_LIMIT_BURST=20
# Proxies whose X-Forwarded-For is trusted (comma-separated host names, IPs
# or CIDRs). Default: the Compose proxy.
# TRUSTED_PROXIES=proxy

# Optional one-time bootstrap administrator (institution_representative).
# Set both or neither; the password needs at least 12 characters.
# An existing account with this username is never modified.
# Remove these values again once the account exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Name of the administrator's institution (default ClearSky). The
# administrator registers it on first sign-in.
# BOOTSTRAP_INSTITUTION=

# Tracing (docs/observability.md). Empty turns it off; 0.1 keeps 10% of traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_TRACES_SAMPLER_ARG=1
# How often grades_query and reviews compare their copies with grades_ingest.
# RECONCILE_INTERVAL=5m
