# Copy to `.env` next to docker-compose.yml and fill in every required value.
# Compose refuses to start while a required value is empty.
# Generate each secret independently, for example: openssl rand -hex 32
# (hex output avoids `$`, which Compose would try to interpolate).

# Required: application JWT signing key shared by user management (issuer)
# and the orchestrator (verifier). At least 32 characters.
JWT_SECRET=

# Required: shared secret for the Google auth -> user management exchange.
# At least 32 characters. Must differ from JWT_SECRET.
INTERNAL_AUTH_TOKEN=

# Required: front-end session signing key. At least 32 characters.
SESSION_SECRET=

# Required: RabbitMQ account used by every service. The broker has no host
# ports; only containers on the Compose network reach it. Use letters and
# digits only (the values are embedded in amqp:// URLs): for example user
# `clearsky` and a password from `openssl rand -hex 32` (paste the output;
# .env does not run commands).
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Optional: must be identical for user management and the orchestrator
# (the root Compose file passes the same values to both).
# JWT_ISSUER=clearsky-identity
# JWT_AUDIENCE=clearsky-api

# Set to true only when browsers reach the services over HTTPS.
COOKIE_SECURE=false

# Google OAuth client (required for Google login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for Google login: university email domains, comma separated.
# Only verified Google accounts of these domains may sign in.
GOOGLE_ALLOWED_DOMAINS=
# true (default): the account must also belong to the university's Google
# Workspace. Set false only if the university does not use Google Workspace.
GOOGLE_REQUIRE_WORKSPACE=true

# Account emails (student confirmation, instructor invitations).
# Unset SMTP_HOST delivers to the local Mailpit inbox (http://127.0.0.1:8025).
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ClearSky <no-reply@example.edu>
# Public front-end address used in emailed links.
PUBLIC_APP_URL=http://localhost:3000

# Optional one-time bootstrap administrator (institution_representative).
# Set both or neither; the password needs at least 12 characters.
# An existing account with this username is never modified.
# Remove these values again once the account exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
