<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Reset your password' }) %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="login-container">
    <fieldset>
      <legend>Reset your password</legend>

      <p>
        Enter the email of your ClearSky account. If it exists, we will send you
        a link to choose a new password (valid for one hour).
      </p>

      <form id="forgot-form" novalidate>
        <div class="form-group">
          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>

        <button class="button" type="submit">Send reset link</button>
        <a class="button button--secondary" href="/login">Back to log-in</a>

        <p id="forgot-status" role="status" style="display:none;margin-top:1rem;"></p>
      </form>
    </fieldset>
  </main>

  <script type="module" src="/js/auth/forgot-password.js"></script>
</body>
</html>
