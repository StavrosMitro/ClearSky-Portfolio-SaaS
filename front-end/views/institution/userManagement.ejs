<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head',{ title }) %>
</head>
<body>
  <%- include('../partials/navbar',{ user }) %>
  <main class="container">
    <%- include('../partials/header') %>

    <!-- Register instructor -->
    <fieldset>
      <legend>Register instructor</legend>
      <p>
        The instructor receives an email link to choose a password. They can
        also sign in with their university Google account.
      </p>
      <form id="instructor-form" novalidate>
        <div class="form-group">
          <label for="instructor-email">Instructor e-mail</label>
          <input id="instructor-email" name="email" type="email" required autocomplete="off" />
        </div>
        <div class="form-group form-group--button">
          <button class="button" type="submit">Register instructor</button>
        </div>
      </form>
    </fieldset>

    <!-- Student registry -->
    <fieldset class="mt-2">
      <legend>Student registry</legend>
      <p>
        Upload a CSV whose header row contains <code>student_id</code> and
        <code>email</code> (comma or semicolon separated). Students can only
        sign up with a student ID and university email that match this
        registry. Format the student ID column as text before exporting, so
        leading zeros are kept.
      </p>
      <form id="roster-form" novalidate>
        <div class="form-group">
          <label for="roster-file">Registry file (.csv, up to 2 MiB)</label>
          <input id="roster-file" name="file" type="file" accept=".csv,text/csv" required />
        </div>
        <div class="form-group form-group--button">
          <button class="button" type="submit">Upload registry</button>
        </div>
      </form>
      <p id="roster-result" role="status" style="display:none;margin-top:1rem;"></p>
    </fieldset>

    <!-- Change Password -->
    <fieldset class="mt-2">
      <legend>Change password</legend>
      <form id="change-pass-form" novalidate>
        <div class="form-group">
          <label for="cp-username">Username</label>
          <input id="cp-username" name="username" required />
        </div>

        <div class="form-group">
          <label for="cp-old">Current password</label>
          <input id="cp-old" name="old_password" type="password" required />
        </div>

        <div class="form-group">
          <label for="cp-new">New password</label>
          <input id="cp-new" name="new_password" type="password" required minlength="8" />
        </div>

        <div class="form-group form-group--button">
          <button class="button" type="submit">Change password</button>
        </div>
      </form>
    </fieldset>

    <%- include('../partials/messageBox') %>
  </main>

  <script type="module" src="/js/institution/user-management.js"></script>
</body>
</html>
